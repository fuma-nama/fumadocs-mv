,788,748,312],"r":12,"title":"Fumadocs UI","text":"Fumadocs UIThe default theme of Fumadocs offers a beautiful look for documentation sites and interactive components."},{"css":[318,561.98,374,156],"px":[636,1124,748,312],"r":12,"title":"Content Source","text":"Content SourceThe source of your content, can be a CMS or local data layers like Fumadocs MDX (the official content source)."},{"css":[704,561.98,374,156],"px":[1408,1124,748,312],"r":12,"title":"Fumadocs CLI","text":"Fumadocs CLIA command line tool to install UI components and automate things, useful for customizing layouts."}]},{"css":[318,733.98,760,74],"px":[636,1468,1520,148],"r":12,"kind":"callout","title":"Want to learn more?","text":"Want to learn more?Read our in-depth What is Fumadocs introduction.","color":"lab(54.1736% 13.3369 -74.6839)"},{"css":[318,839.98,760,32],"px":[636,1680,1520,64],"kind":"h3","id":"terminology","text":"Terminology"},{"css":[318,883.98,760,56],"px":[636,1768,1520,112],"kind":"p","text":"Markdown/MDX: Markdown is a markup language for creating formatted text. Fumadocs natively supports Markdown and MDX (superset of Markdown)."},{"css":[318,959.98,760,56],"px":[636,1920,1520,112],"kind":"p","text":"Bun: A JavaScript runtime, it will be used in our guides for running scripts. If you prefer Node.js, try unrun instead."},{"css":[318,1035.98,760,28],"px":[636,2072,1520,56],"kind":"p","text":"Some basic knowledge of React.js would be useful for further customizations."},{"css":[318,1111.98,760,31.98],"px":[636,2224,1520,64],"kind":"h2","id":"automatic-installation","text":"Automatic Installation"},{"css":[318,1167.97,760,28],"px":[636,2336,1520,56],"kind":"p","text":"A minimum version of Node.js 22 required."},{"css":[318,1215.97,760,81.56],"px":[636,2432,1520,163],"r":12,"kind":"codetabs","list":[319,1216.97,758,32],"tabs":[{"css":[327,1216.97,44.78,32],"px":[654,2434,90,64],"text":"npm","selected":true},{"css":[371.78,1216.97,53.16,32],"px":[744,2434,106,64],"text":"pnpm","selec