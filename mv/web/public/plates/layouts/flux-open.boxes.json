52,794,824,272],"r":12,"title":"Fumadocs UI","text":"Fumadocs UIThe default theme of Fumadocs offers a beautiful look for documentation sites and interactive components."},{"css":[302,544.98,412,136],"px":[604,1090,824,272],"r":12,"title":"Content Source","text":"Content SourceThe source of your content, can be a CMS or local data layers like Fumadocs MDX (the official content source)."},{"css":[726,544.98,412,136],"px":[1452,1090,824,272],"r":12,"title":"Fumadocs CLI","text":"Fumadocs CLIA command line tool to install UI components and automate things, useful for customizing layouts."}]},{"css":[302,696.98,836,74],"px":[604,1394,1672,148],"r":12,"kind":"callout","title":"Want to learn more?","text":"Want to learn more?Read our in-depth What is Fumadocs introduction.","color":"lab(54.1736% 13.3369 -74.6839)"},{"css":[302,802.98,836,32],"px":[604,1606,1672,64],"kind":"h3","id":"terminology","text":"Terminology"},{"css":[302,846.98,836,56],"px":[604,1694,1672,112],"kind":"p","text":"Markdown/MDX: Markdown is a markup language for creating formatted text. Fumadocs natively supports Markdown and MDX (superset of Markdown)."},{"css":[302,922.98,836,28],"px":[604,1846,1672,56],"kind":"p","text":"Bun: A JavaScript runtime, it will be used in our guides for running scripts. If you prefer Node.js, try unrun instead."},{"css":[302,970.98,836,28],"px":[604,1942,1672,56],"kind":"p","text":"Some basic knowledge of React.js would be useful for further customizations."},{"css":[302,1046.98,836,31.98],"px":[604,2094,1672,64],"kind":"h2","id":"automatic-installation","text":"Automatic Installation"},{"css":[302,1102.97,836,28],"px":[604,2206,1672,56],"kind":"p","text":"A minimum version of Node.js 22 required."},{"css":[302,1150.97,836,81.56],"px":[604,2302,1672,163],"r":12,"kind":"codetabs","list":[303,1151.97,834,32],"tabs":[{"css":[311,1151.97,44.78,32],"px":[622,2304,90,64],"text":"npm","selected":true},{"css":[355.78,1151.97,53.16,32],"px":[712,2304,106,64],"text":"pnpm","selec