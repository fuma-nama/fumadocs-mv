{"viewport":[1440,810],"dpr":2,"overlay":{"css":[0,0,1440,810],"px":[0,0,2880,1620],"background":"rgba(0, 0, 0, 0.2)","backdropFilter":"blur(4px)"},"dialog":{"css":[400,155,640,517],"px":[800,310,1280,1034],"r":12,"shadow":"rgba(0, 0, 0, 0) 0px 0px 0px 0px, rgba(0, 0, 0, 0) 0px 0px 0px 0px, rgba(0, 0, 0, 0) 0px 0px 0px 0px, rgba(0, 0, 0, 0) 0px 0px 0px 0px, rgba(0, 0, 0, 0.25) 0px 25px 50px -12px"},"header":null,"icon":{"css":[413,173,20,20],"px":[826,346,40,40]},"input":{"css":[441,169,538.39,28],"px":[882,338,1077,56],"value":"contents","placeholder":"Search","font":"18px / 28px geist, \"geist Fallback\""},"caret":[513.08,171.75,1,22.5],"close":{"css":[987.39,168,39.61,30],"px":[1975,336,79,60],"r":6,"text":"ESC"},"list":{"css":[401,211,638,460],"px":[802,422,1276,920]},"rows":[{"css":[405,215,630,56],"px":[810,430,1260,112],"r":8,"kind":"page","text":"Introduction","breadcrumbs":"FumadocsGetting Started","active":true,"textBox":[415,243,610,20],"lines":[[415,243,610,20]]},{"css":[405,271,630,36],"px":[810,542,1260,72],"r":8,"kind":"heading","text":"Table of Contents","active":false,"textBox":[415,279,610,20],"lines":[[447,279,578,20]]},{"css":[405,307,630,36],"px":[810,614,1260,72],"r":8,"kind":"text","text":"The classic: sidebar, article and table of contents.","active":false,"textBox":[415,315,610,20],"lines":[[431,315,594,20]]},{"css":[405,343,630,56],"px":[810,686,1260,112],"r":8,"kind":"text","text":"Translucent surfaces, a floating sidebar and a minimap table of contents that expands on hover.","active":false,"textBox":[415,351,610,40],"lines":[[431,351,594,40]]},{"css":[405,399,630,36],"px":[810,798,1260,72],"r":8,"kind":"text","text":"On smaller screens, the table of contents collapses into a popover bar with a progress circle.","active":false,"textBox":[415,407,610,20],"lines":[[431,407,594,20]]},{"css":[405,435,630,56],"px":[810,870,1260,112],"r":8,"kind":"text","text":"The default layout. A sidebar with your page tree, the article in the middle and the table of contents on the right.","active":false,"textBox":[415,443,610,40],"lines":[[431,443,594,40]]},{"css":[405,491,630,56],"px":[810,982,1260,112],"r":8,"kind":"text","text":"Each heading becomes a tick on the right edge of the page. Hover the ticks, and the minimap unfolds into a full table of contents.","active":false,"textBox":[415,499,610,40],"lines":[[431,499,594,40]]},{"css":[405,547,630,56],"px":[810,1094,1260,112],"r":8,"kind":"text","text":"The page sits in an inset panel on a card surface, with a table of contents that rolls the active heading in as you scroll.","active":false,"textBox":[415,555,610,40],"lines":[[431,555,594,40]]},{"css":[405,603,630,56],"px":[810,1206,1260,112],"r":8,"kind":"text","text":"Every page gets a table of contents generated from its headings. The active headings follow your scroll position, and a thin path traces the depth of each section.","active":false,"textBox":[415,611,610,40],"lines":[[431,611,594,40]]},{"css":[405,659,630,56],"px":[810,1318,1260,112],"r":8,"kind":"page","text":"Docs Layout","breadcrumbs":"FumadocsUILayouts","active":false,"textBox":[415,687,610,20],"lines":[[415,687,610,20]]},{"css":[405,715,630,36],"px":[810,1430,1260,72],"r":8,"kind":"text","text":"The default layout of Fumadocs: sidebar, article and table of contents.","active":false,"textBox":[415,723,610,20],"lines":[[431,723,594,20]]},{"css":[405,751,630,56],"px":[810,1502,1260,112],"r":8,"kind":"text","text":"The Docs Layout layout is one of the layouts of Fumadocs UI. The default layout of Fumadocs: sidebar, article and table of contents.","active":false,"textBox":[415,759,610,40],"lines":[[431,759,594,40]]},{"css":[405,807,630,56],"px":[810,1614,1260,112],"r":8,"kind":"page","text":"Glass","breadcrumbs":"FumadocsUILayouts","active":false,"textBox":[415,835,610,20],"lines":[[415,835,610,20]]},{"css":[405,863,630,36],"px":[810,1726,1260,72],"r":8,"kind":"text","text":"A layout with translucent surfaces and a minimap table of contents.","active":false,"textBox":[415,871,610,20],"lines":[[431,871,594,20]]},{"css":[405,899,630,56],"px":[810,1798,1260,112],"r":8,"kind":"text","text":"The Glass layout is one of the layouts of Fumadocs UI. A layout with translucent surfaces and a minimap table of contents.","active":false,"textBox":[415,907,610,40],"lines":[[431,907,594,40]]},{"css":[405,955,630,56],"px":[810,1910,1260,112],"r":8,"kind":"page","text":"Themes","breadcrumbs":"FumadocsUI","active":false,"textBox":[415,983,610,20],"lines":[[415,983,610,20]]},{"css":[405,1011,630,77],"px":[810,2022,1260,154],"r":8,"kind":"text","text":"Fumadocs UI adds its own colors, animations and utilities with a Tailwind CSS preset. Import a preset in your global.css, and every component, from the sidebar to the table of contents, follows it.","active":false,"textBox":[415,1019,610,61],"lines":[[431,1019,594,61]]}],"footer":{"css":[401,211,638,460],"px":[802,422,1276,920]}}