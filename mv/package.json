{
  "name": "fumadocs-mv",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "still": "node render/still.mjs",
    "sheet": "node render/sheet.mjs",
    "render": "node render/render.mjs",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite -c web/vite.config.ts",
    "assets:web": "node web/build-assets.mjs",
    "build:web": "vite build -c web/vite.config.ts",
    "preview:web": "vite preview -c web/vite.config.ts"
  },
  "dependencies": {
    "simplex-noise": "4.0.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "ws": "8.22.0"
  }
}
